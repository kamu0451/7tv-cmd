  {
    "provider": "fossabot",
    "publicUrlPattern": "https://fossabot.com/<slug>/commands (slug = Twitch login)",
    "endpointChain": [
      {
        "method": "GET",
        "urlTemplate": "https://fossabot.com/api/v2/cached/channels/by-slug/<login>",
        "headers": {}
      },
      {
        "method": "GET",
        "urlTemplate": "https://fossabot.com/api/v2/cached/channels/<id>/commands",
        "headers": {}
      }
    ],
    "loginToId": "$.channel.id from step 1 (string, Fossabot internal); $.channel.provider_id is the Twitch user id; fossadev-* headers the page sends are not required",
    "listPath": "$.commands",
    "fields": {
      "name": "$.commands[].name (no leading \"!\")",
      "aliases": "$.commands[].aliases[]",
      "response": "$.commands[].response",
      "cooldown": "none (not exposed)",
      "userLevel": "$.commands[].role_ids[] joined to $.roles[].name (empty = everyone)",
      "enabled": "$.commands[].enabled_online / enabled_offline (no single flag; default commands included)"
    },
    "channels": [
      {
        "login": "twitchdev",
        "count": 32
      },
      {
        "login": "kaajak1",
        "count": 72
      },
