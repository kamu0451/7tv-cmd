    "fields": {
      "name": "$[].command (no leading \"!\")",
      "aliases": "$[].aliases[]",
      "response": "$[].reply",
      "cooldown": "$[].cooldown.user and $[].cooldown.global (seconds)",
      "userLevel": "$[].accessLevel (number: 100, 500, 1000 seen)",
      "enabled": "$[].enabled plus enabledOnline/enabledOffline; disabled commands ARE returned (16/176, 5/19, 69/75)"
