  {
    "provider": "moobot",
    "publicUrlPattern": "https://moo.bot/r/commands#<login> (login in the URL fragment)",
    "endpointChain": [
      {
        "method": "POST",
        "urlTemplate": "https://moo.bot/a/1/channel/meta",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
          "Accept": "application/json"
        },
        "body": "name=<login>"
      },
      {
        "method": "POST",
        "urlTemplate": "https://moo.bot/a/1/channel/public/commands/list",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
          "Accept": "application/json"
        },
        "body": "_limit=15&_offset=0&_order=identifier&channel=<userid>"
      }
    ],
    "loginToId": "$.channel.userid from step 1 (the Twitch user id); absent when Moobot does not know the login",
    "listPath": "$.list",
    "fields": {
      "name": "$.list[].identifier (no leading \"!\")",
      "aliases": "none",
      "response": "$.list[].response (placeholders in angle brackets)",
      "cooldown": "none",
      "userLevel": "none (restricted commands hidden per docs)",
      "enabled": "none (disabled commands hidden per docs)"
    },
    "channels": [
      {
        "login": "pokimane",
        "count": 1
      }
    ],
    "negative": {
      "status": 200,
      "bodySummary": "unknown login: {\"version\":476,\"assistant\":\"1.1.14\"} with no channel key; known channel without commands: {\"list\":[],\"_total\":0}"
    },
    "cors": "Access-Control-Allow-Origin: https://moo.bot (fixed, not reflected): twitch.tv pages cannot read it, background fetch needed",
    "requestsUsed": 20,
    "fixtures": [
      "test/fixtures/moobot/_negative-esl_csgo.channel.json",
      "test/fixtures/moobot/_negative-esl_csgo.commands.json",
      "test/fixtures/moobot/_negative-ninja.channel.json",
      "test/fixtures/moobot/_negative-ninja.commands.json",
      "test/fixtures/moobot/_negative-northernlion.channel.json",
      "test/fixtures/moobot/_negative-northernlion.commands.json",
      "test/fixtures/moobot/_negative-nosuchuser.channel.json",
      "test/fixtures/moobot/_negative-sodapoppin.channel.json",
      "test/fixtures/moobot/pokimane.channel.json",
      "test/fixtures/moobot/pokimane.commands.json"
    ]
  }
