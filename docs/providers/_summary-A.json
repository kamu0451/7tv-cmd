[
  {
    "provider": "nightbot",
    "publicUrlPattern": "https://nightbot.tv/t/<login>/commands",
    "endpointChain": [
      {
        "method": "GET",
        "urlTemplate": "https://api.nightbot.tv/1/channels/twitch/<login>",
        "headers": {}
      },
      {
        "method": "GET",
        "urlTemplate": "https://api.nightbot.tv/1/commands",
        "headers": {
          "Nightbot-Channel": "<id>"
        }
      }
    ],
    "loginToId": "$.channel._id from step 1 (24 hex); $.channel.providerId is the Twitch user id",
    "listPath": "$.commands",
    "fields": {
      "name": "$.commands[].name (usually with leading \"!\", sometimes without: strip it)",
      "aliases": "$.commands[].alias (single string, \"\" in all fixtures)",
      "response": "$.commands[].message",
      "cooldown": "$.commands[].coolDown (seconds)",
      "userLevel": "$.commands[].userLevel (everyone, moderator seen)",
      "enabled": "none (no field)"
    },
    "channels": [
      {
        "login": "coconutb",
        "count": 75
      },
      {
        "login": "nickmercs",
        "count": 102
      },
      {
        "login": "lirik",
        "count": 1
      }
    ],
    "negative": {
      "status": 404,
      "bodySummary": "login unknown to Nightbot (dansgaming): {\"message\":\"user not found\",\"status\":404} on step 1; missing Nightbot-Channel header gives 400 {\"message\":\"invalid channel\"}; twitch exists with 4 commands so it is not negative"
    },
    "cors": "Access-Control-Allow-Origin reflects the request Origin (https://nightbot.tv and https://www.twitch.tv tested; preflight 204 allows Nightbot-Channel); none sent without Origin",
    "requestsUsed": 20,
    "fixtures": [
      "test/fixtures/nightbot/_negative-dansgaming.channel.json",
      "test/fixtures/nightbot/_negative-noheader.commands.json",
      "test/fixtures/nightbot/_negative-summit1g.channel.json",
      "test/fixtures/nightbot/_negative-timthetatman.channel.json",
      "test/fixtures/nightbot/coconutb.channel.json",
      "test/fixtures/nightbot/coconutb.commands.json",
      "test/fixtures/nightbot/lirik.channel.json",
      "test/fixtures/nightbot/lirik.commands.json",
      "test/fixtures/nightbot/nickmercs.channel.json",
      "test/fixtures/nightbot/nickmercs.commands.json",
      "test/fixtures/nightbot/twitch.channel.json",
      "test/fixtures/nightbot/twitch.commands.json"
    ]
  },
  {
